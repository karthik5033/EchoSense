# ==============================================================================
# EchoSense Environment Variables
# ==============================================================================

# Backend API & Gateway
PROJECT_NAME="EchoSense API"
API_V1_STR="/api/v1"
SECRET_KEY="echosense-super-secure-production-secret-key-340ms-lead-time"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Local SQLite fallback: sqlite+aiosqlite:///./echosense.db
# Docker Postgres: postgresql+asyncpg://echosense:echosense_dev_secret@localhost:5432/echosensedb
DATABASE_URL="sqlite+aiosqlite:///./echosense.db"
POSTGRES_USER="echosense"
POSTGRES_PASSWORD="echosense_dev_secret"
POSTGRES_DB="echosensedb"

# Redis
REDIS_URL="redis://localhost:6379/0"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"

# Mobile (Expo Go)
EXPO_PUBLIC_API_URL="http://localhost:8000/api/v1"
